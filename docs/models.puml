@startuml Models

hide empty members

skinparam Linetype ortho

class IdentityUser <<Identity>> #EEEEEE;line:AAAAAA;text:888888 {
    +Id : string <<PK>>
    +UserName : string
    +Email : string
    +PasswordHash : string
    ...
}

class User #EEEEEE;line:AAAAAA;text:888888 {
    +Coins : int
    .. navigational ..
    +CardUsers : ICollection<CardUser>
    +Listings : ICollection<Listing>
}

class Card {
    +Id : int <<PK>>
    +Name : string [100]
    +Rarity : CardRarity
    +Element : CardElement
    +Description : string [200]
    +Lore : string? [2000]
    +ImageUrl : string [500]
    .. navigational ..
    +<color:#888888>CardUsers : ICollection<CardUser></color>
    +<color:#888888>Listings : ICollection<Listing></color>
}

enum CardRarity {
    Common = 0
    Uncommon = 1
    Rare = 2
    Epic = 3
    Legendary = 4
}

enum CardElement {
    Neutral = 0
    Water = 1
    Earth = 2
    Fire = 3
    Air = 4
    Light = 5
    Dark = 6
}

class CardUser #EEEEEE;line:AAAAAA;text:888888 {
    +Id : int <<PK>>
    +UserId : string <<FK>>
    +CardId : int <<FK>>
    .. navigational ..
    +User : User
    +Card : Card
}

class Listing #EEEEEE;line:AAAAAA;text:888888 {
    +Id : int <<PK>>
    +SellerId : string <<FK>>
    +CardId : int <<FK>>
    +Price : int
    +CreatedAt : DateTime
    +SoldAt : DateTime?
    .. navigational ..
    +Seller : User
    +Card : Card
}

class Pack #EEEEEE;line:AAAAAA;text:888888 {
    +Id : int <<PK>>
    +Name : string [100]
    +ImageUrl : string [500]
    +Price : int
    +CardCount : int
    .. navigational ..
    +DropRates : ICollection<PackDropRate>
}

class PackDropRate #EEEEEE;line:AAAAAA;text:888888 {
    +PackId : int <<PK, FK>>
    +Rarity : CardRarity <<PK>>
    +Weight : int
    .. navigational ..
    +Pack : Pack
}


IdentityUser <|-[#AAAAAA]- User
Card ..> CardRarity
Card ..> CardElement
PackDropRate .[#AAAAAA].> CardRarity

CardUser }o-[#AAAAAA]-|| Card
CardUser }o-[#AAAAAA]-|| User

User ||-[#AAAAAA]-o{ Listing
Card ||-[#AAAAAA]-o{ Listing

Pack ||-[#AAAAAA]-o{ PackDropRate

@enduml
